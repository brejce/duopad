<?xml version="1.0" encoding="utf-8"?>
<!--
  DuoPad 图标：双屏翻盖掌机的剪影。

  视口 108×108。构图：
    上屏（描边 + 光标横线）= 正在上屏输入
    铰链窄条
    下屏（大块键盘）= 本项目提供的下屏键盘

  下屏特意做得比上屏大：这是本项目的本体，缩到 48dp 也要一眼看出是键盘。
  整机描一圈浅边的理由：纯深色方块在深色壁纸上会糊掉，加边才有轮廓。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 机身：深色圆角块 + 浅色描边（深色壁纸上也有轮廓） -->
    <path
        android:fillColor="#242429"
        android:strokeColor="#5A5A66"
        android:strokeWidth="1.5"
        android:pathData="M18,8 h72 a10,10 0 0 1 10,10 v72 a10,10 0 0 1 -10,10 H18 a10,10 0 0 1 -10,-10 V18 a10,10 0 0 1 10,-10 z" />

    <!-- 上屏 -->
    <path
        android:fillColor="#0E0E12"
        android:strokeColor="#7FB3E8"
        android:strokeWidth="3.5"
        android:pathData="M25,16 h58 a5,5 0 0 1 5,5 v19 a5,5 0 0 1 -5,5 H25 a5,5 0 0 1 -5,-5 V21 a5,5 0 0 1 5,-5 z" />

    <!-- 上屏内容：两行文字条（缩小时读作"在用"） -->
    <path android:fillColor="#7FB3E8" android:pathData="M29,24 h26 v3 h-26 z" />
    <path android:fillColor="#4E6E88" android:pathData="M29,31 h38 v3 h-38 z" />

    <!-- 铰链 -->
    <path android:fillColor="#3A3A42" android:pathData="M42,50 h24 v3 h-24 z" />

    <!-- 下屏（键盘面板）：比上屏大 -->
    <path
        android:fillColor="#15151A"
        android:strokeColor="#E8E8F0"
        android:strokeWidth="2.5"
        android:pathData="M25,57 h58 a5,5 0 0 1 5,5 v21 a5,5 0 0 1 -5,5 H25 a5,5 0 0 1 -5,-5 V62 a5,5 0 0 1 5,-5 z" />

    <!-- 键位：上排 5 键 -->
    <path android:fillColor="#E8E8F0" android:pathData="M28,62 h8 v7 h-8 z" />
    <path android:fillColor="#E8E8F0" android:pathData="M39,62 h8 v7 h-8 z" />
    <path android:fillColor="#E8E8F0" android:pathData="M50,62 h8 v7 h-8 z" />
    <path android:fillColor="#E8E8F0" android:pathData="M61,62 h8 v7 h-8 z" />
    <path android:fillColor="#E8E8F0" android:pathData="M72,62 h8 v7 h-8 z" />

    <!-- 键位：下排 = 功能键 + 空格条 -->
    <path android:fillColor="#7FB3E8" android:pathData="M28,72 h8 v7 h-8 z" />
    <path android:fillColor="#E8E8F0" android:pathData="M39,72 h30 v7 h-30 z" />
    <path android:fillColor="#7FB3E8" android:pathData="M72,72 h8 v7 h-8 z" />
</vector>
